# ========================================
# SUPABASE (Base de Datos)
# ========================================
# Ve a tu dashboard Supabase → Settings → API
# Copia Project URL y anon public key

SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ========================================
# SEGURIDAD
# ========================================
# Usa una frase aleatoria (para encriptar tokens)
SECRET_KEY=tu-frase-secreta-aqui-cambiala

# ========================================
# CONFIGURACIÓN
# ========================================
DEBUG=False
PORT=5000

# ========================================
# CORS (qué dominios pueden hablar con tu backend)
# ========================================
# Durante desarrollo: localhost
# En producción: tu dominio Vercel
CORS_ORIGINS=http://localhost:3000,https://toolbox.mx,https://www.toolbox.mx
